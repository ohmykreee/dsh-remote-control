{
  "name": "dsh-remote-control",
  "version": "1.0.0",
  "private": true,
  "description": "A touch-first LAN console for DeepSeek Harness built with Svelte 5, shadcn-svelte, and Lucide icons.",
  "license": "MIT",
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "scripts": {
    "dev": "vite",
    "build": "node scripts/build-dsh.mjs && node scripts/build-web.mjs",
    "build:dsh": "node scripts/build-dsh.mjs",
    "build:web": "node scripts/build-web.mjs",
    "build:rust": "node scripts/build-rust.mjs",
    "preview": "vite preview",
    "shot": "node scripts/browser-shot.mjs",
    "check": "tsc -p tsconfig.dsh.json --noEmit && tsc -p tsconfig.dsh-client.json --noEmit && svelte-check --tsconfig ./tsconfig.json",
    "test": "node test/smoke.mjs && node test/i18n.mjs && node test/countdown.mjs && node test/media-progress.mjs && node test/probe-bridge.mjs && node test/probe-daemon.mjs && node test/notifications.mjs && node test/notification-watch.mjs && node test/app-mapping.mjs && node test/questions.mjs",
    "postinstall": "node scripts/build-dsh.mjs && node scripts/build-web.mjs && node scripts/build-rust.mjs --optional"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "lib/**/*.js",
    "src/**",
    "static/**",
    "index.html",
    "vite.config.js",
    "svelte.config.js",
    "components.json",
    "tsconfig.json",
    "tsconfig.dsh.json",
    "tsconfig.dsh-client.json",
    "scripts/**/*.mjs",
    "scripts/**/*.py",
    "scripts/**/*.sh",
    "README.md",
    "INSTALLATION.md",
    "AGENTS.md",
    "docs/**",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/noto-sans-sc": "^5.3.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "qrcode-generator": "^2.0.4",
    "svelte": "^5.57.3",
    "terser": "^5.51.2",
    "typescript": "~6.0.3",
    "vite": "^8.3.8"
  },
  "devDependencies": {
    "@internationalized/date": "^3.12.0",
    "@lucide/svelte": "^1.72.0",
    "@tailwindcss/vite": "^4.3.5",
    "bits-ui": "^2.20.0",
    "cn": "^0.5.2",
    "playwright-core": "^1.65.0",
    "shadcn-svelte": "^1.8.1",
    "svelte-check": "^4.7.8",
    "tailwind-variants": "^3.3.0",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "^1.4.0"
  }
}
