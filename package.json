{
  "name": "dsh-remote-control",
  "version": "1.0.0",
  "private": true,
  "description": "A 1280×800 touch-first LAN console for DeepSeek Harness with home, sessions, music, performance, settings, HTTPS, and batch page layout.",
  "license": "MIT",
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "scripts": {
    "dev": "vite",
    "build": "node scripts/build-web.mjs",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "build:rust": "node scripts/build-rust.mjs",
    "test": "node test/smoke.mjs && node test/media-progress.mjs && node test/probe-bridge.mjs && node test/notifications.mjs && node test/notification-watch.mjs",
    "postinstall": "node scripts/build-web.mjs && node scripts/build-rust.mjs --optional"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "lib/**/*.js",
    "src/**",
    "static/**",
    "index.html",
    "vite.config.js",
    "svelte.config.js",
    "tsconfig.json",
    "native/rust/Cargo.toml",
    "native/rust/Cargo.lock",
    "native/rust/src/**/*.rs",
    "native/rust/tests/**/*.rs",
    "scripts/**/*.mjs",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/noto-sans-sc": "^5.3.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "qrcode-generator": "^2.0.4",
    "svelte": "^5.57.3",
    "vite": "^8.3.8"
  },
  "devDependencies": {
    "svelte-check": "^4.7.8",
    "typescript": "~6.0.3"
  }
}
