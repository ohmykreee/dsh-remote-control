{
  "name": "@ohmykreee/dsh-remote-control",
  "version": "1.1.3",
  "description": "A touch-first LAN console for DeepSeek Harness built with Svelte 5, shadcn-svelte, and Lucide icons.",
  "license": "MIT",
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ohmykreee/dsh-remote-control.git"
  },
  "homepage": "https://github.com/ohmykreee/dsh-remote-control#readme",
  "bugs": {
    "url": "https://github.com/ohmykreee/dsh-remote-control/issues"
  },
  "keywords": [
    "dsh",
    "dsh-bundle",
    "dsh-plugin",
    "deepseek-harness",
    "remote-control",
    "lan",
    "svelte",
    "touch"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "dev": "vite",
    "build": "node scripts/build-dsh.mjs && node scripts/build-web.mjs",
    "build:dsh": "node scripts/build-dsh.mjs",
    "build:web": "node scripts/build-web.mjs",
    "build:rust": "node scripts/build-rust.mjs",
    "preview": "vite preview",
    "shot": "node scripts/browser-shot.mjs",
    "check": "tsc -p tsconfig.dsh.json --noEmit && tsc -p tsconfig.dsh-client.json --noEmit && tsc -p tsconfig.unit.json --noEmit && svelte-check --tsconfig ./tsconfig.json",
    "test": "node test/dsh/smoke.mjs && node test/dsh/questions.mjs && node test/dsh/quickqa.mjs && node test/dsh/settings.mjs && node test/dsh/proxy.mjs && node test/dsh/media.mjs && node test/dsh/notifications.mjs && node test/dsh/weather.mjs",
    "test:unit": "vitest run",
    "pack:check": "node scripts/check-npm-package.mjs"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "lib/**/*.js",
    "web/**",
    "src/dsh/**",
    "src/svelte/**",
    "src/rust/Cargo.toml",
    "src/rust/Cargo.lock",
    "src/rust/src/**",
    "src/rust/tests/**",
    "static/**",
    "vite.config.js",
    "vitest.config.ts",
    "svelte.config.js",
    "components.json",
    "tsconfig.json",
    "tsconfig.dsh.json",
    "tsconfig.dsh-client.json",
    "tsconfig.unit.json",
    "scripts/**/*.mjs",
    "scripts/**/*.py",
    "scripts/**/*.sh",
    "README.md",
    "INSTALLATION.md",
    "AGENTS.md",
    "docs/**",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "dependencies": {
    "qrcode-generator": "^2.0.4"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-api-session-controller": "0.2.2-rc.5",
    "@deepseek-ai/dsh-experimental-api-speech-to-text": "0.2.2-rc.5",
    "@deepseek-ai/dsh-experimental-speech-to-text": "0.2.2-rc.5",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/noto-sans-sc": "^5.3.1",
    "@internationalized/date": "^3.12.0",
    "@lucide/svelte": "^1.72.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "bits-ui": "^2.20.0",
    "cn": "^0.5.2",
    "dompurify": "^3.4.18",
    "marked": "^18.2.1",
    "photoswipe": "^5.4.4",
    "playwright-core": "^1.65.0",
    "shadcn-svelte": "^1.8.1",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.8",
    "tailwind-variants": "^3.3.0",
    "tailwindcss": "^4.3.5",
    "terser": "^5.51.2",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6.0.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
