{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "allowJs": false,
    "skipLibCheck": true,
    "paths": {
      "$lib": ["./src/svelte/lib"],
      "$lib/*": ["./src/svelte/lib/*"]
    },
    "types": ["vite/client"]
  },
  "include": ["src/svelte/**/*.ts", "src/svelte/**/*.svelte", "vite.config.js", "svelte.config.js"]
}
